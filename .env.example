# Environment Variables Configuration

# System & Offline Mode Flags
OFFLINE_MODE=true
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Database Configuration (PostgreSQL + PostGIS)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=eo_archive
POSTGRES_USER=eo_admin
POSTGRES_PASSWORD=eo_password
DATABASE_URL=postgresql://eo_admin:eo_password@localhost:5432/eo_archive

# Vector DB Configuration (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=tile_embeddings

# MinIO / Object Storage Configuration
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=eo_admin
MINIO_ROOT_PASSWORD=eo_password

# Storage Directories
DATA_DIR=./data
MODELS_DIR=./models

# FastAPI Backend Configuration
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change_this_in_production_environment

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_TITILER_BASE_URL=http://localhost:8080
